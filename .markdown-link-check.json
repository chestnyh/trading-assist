{
  "ignorePatterns": [
    { "pattern": "^#" },
    { "pattern": "^mailto:" },
    { "pattern": "^tel:" },
    { "pattern": "^javascript:" },
    { "pattern": "^http://localhost" },
    { "pattern": "^https://localhost" },
    { "pattern": "^http://127\\.0\\.0\\.1" },
    { "pattern": "^https://127\\.0\\.0\\.1" },
    { "pattern": "^http://0\\.0\\.0\\.0" },
    { "pattern": "^https://0\\.0\\.0\\.0" },

    { "pattern": "^(?!https?://)" },

    { "pattern": "^https://github\\.com/chestnyh/trading-assist" },
    { "pattern": "^https://github\\.com/chestnyh/trading-bot" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^\\./",
      "replacement": "{{BASEURL}}/"
    },
    {
      "pattern": "^_docs/",
      "replacement": "{{BASEURL}}/_docs/"
    },
    {
      "pattern": "^apps/",
      "replacement": "{{BASEURL}}/apps/"
    },
    {
      "pattern": "^libs/",
      "replacement": "{{BASEURL}}/libs/"
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 2,
  "fallbackRetryDelay": "10s"
}
