{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "//comment": "We have documentation for all commands bellow in _docs/project-commands.md file. Please refer to it for more information. Or add update _docs/project-commands.md if you add new command.",
    "auto-trader:build": "nx run auto-trader:build",
    "auto-trader:test": "nx test auto-trader",
    "auto-trader:test:watch": "nx test auto-trader --watch",
    "auto-trader:start": "nx run auto-trader:serve",
    "auto-trader:lint": "nx run auto-trader:lint",
    "//api-service": "API service is a microservice that is responsible for the API of the trading bot.",
    "api:start": "nx run api:serve",
    "api:build": "nx run api:build",
    "api:test": "nx run api:test",
    "//log-stream": "Log stream is a microservice that streams rule execution logs via SSE.",
    "log-stream:start": "nx run log-stream:serve",
    "log-stream:build": "nx run log-stream:build",
    "//api-e2e": "API e2e is a tool that is responsible for the API e2e tests of the trading bot.",
    "api-e2e:pre-e2e": "nx run api-e2e:pre-e2e",
    "api-e2e:e2e": "nx run api-e2e:e2e",
    "api-e2e:post-e2e": "nx run api-e2e:post-e2e",
    "api-e2e:run-e2e-flow": "nx run api-e2e:run-e2e-flow",
    "//api-client": "API client is a library that is responsible for the API client of the trading bot.",
    "api-client:generate-openapi": "nx run api-client:generate-openapi",
    "api-client:generate-client": "nx run api-client:generate-client",
    "//user-control-panel": "User control panel is a microservice that is responsible for the user control panel of the trading bot.",
    "user-control-panel:start": "nx run user-control-panel:serve:development",
    "user-control-panel:build": "nx run user-control-panel:build",
    "user-control-panel:build:dev": "nx run user-control-panel:build:development",
    "user-control-panel:test": "nx run user-control-panel:test",
    "user-control-panel:test-coverage": "jest --coverage --testPathPattern=user-control-panel",
    "user-control-panel:lint": "nx run user-control-panel:lint",
    "//object-navigator": "Object navigator is a tool that is responsible for the object navigator of the trading assist.",
    "object-navigator:show": "nx show project object-navigator",
    "object-navigator:test": "nx run object-navigator:test",
    "//crypto-utils": "Crypto utils is a library that is responsible for the crypto utils of the trading bot.",
    "crypto-utils:build": "nx run crypto-utils:build",
    "crypto-utils:test": "nx run crypto-utils:test",
    "//monorepo": "Monorepo is a tool that is responsible for the monorepo of the trading assist.",
    "monorepo:show": "nx show projects",
    "monorepo:graph": "nx graph",
    "monorepo:create-app:console": "nx g @nx/node:application --framework none",
    "//models": "Models is a library that is responsible for the models of the trading assist.",
    "models:build": "nx run models:build",
    "models:test": "nx run models:test",
    "models:lint": "nx run models:lint",
    "models:migrations:run": "nx run models:migrations:run",
    "models:migrations:dev": "nx run models:migrations:dev",
    "models:migrations:seed": "nx run models:migrations:seed",
    "models:migrations:reset": "nx run models:migrations:reset",
    "models:migrations:generate": "nx run models:migrations:generate",
    "models:copy-generated": "nx run models:copy-generated",
    "models:client:generate": "nx run models:migrations:generate",
    "models:migrations:migrate-and-seed": "nx run models:migrations:run; nx run models:migrations:seed seed/initial.js",
    "//configs": "Configs is a library that is responsible for the configs of the trading assist.",
    "configs:build": "nx run configs:build",
    "check:md-links": "ts-node -P scripts/tsconfig.scripts.json scripts/check-markdown-links.ts --all",
    "check:md-links:staged": "ts-node -P scripts/tsconfig.scripts.json scripts/check-markdown-links.ts",
    "//all": "All is a tool that is responsible for the command that can be run for all services of the trading assist.",
    "all:build": "nx run-many --target=build --all",
    "all:start": "nx run-many --target=serve --all --parallel=5",
    "all:test": "nx run-many --target=test --all",
    "all:lint": "nx run-many --target=lint --all",
    "//development": "Docker is a tool that is responsible for the docker of the trading assist.",
    "development:check-env-file": "nx run development:check-env-file",
    "development:check-envs:examples-check": "nx run development:check-envs -- examples-check",
    "development:check-envs:local-checks": "nx run development:check-envs -- local-checks",
    "development:check-markdown-links:staged": "nx run development:check-markdown-links -- staged",
    "development:dev-tools-checking": "nx run development:dev-tools-checking",
    "development:create-volume-folder": "nx run development:create-volume-folder",
    "development:external-up": "nx run development:external-up",
    "development:sleep": "nx run development:sleep",
    "development:lint": "nx run development:lint",
    "prepare": "husky",
    "all:knip": "knip"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@nx/esbuild": "20.4.6",
    "@nx/eslint": "20.4.6",
    "@nx/eslint-plugin": "20.4.6",
    "@nx/jest": "20.4.6",
    "@nx/js": "20.4.6",
    "@nx/react": "19.6.5",
    "@nx/webpack": "20.4.6",
    "@prisma/client": "^7.8.0",
    "@swc-node/register": "~1.9.2",
    "@swc/core": "~1.5.29",
    "@swc/helpers": "~0.5.15",
    "@types/jest": "^29.5.14",
    "@types/node": "~18.16.20",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.19.2",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.32.2",
    "nx": "20.4.6",
    "orval": "^7.17.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.3.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "marked": "4.3.0",
      "undici": "6.21.3",
      "prisma": "^7.8.0",
      "@prisma/client": "^7.8.0"
    },
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "@tailwindcss/postcss",
      "core-js-pure",
      "cpu-features",
      "esbuild",
      "nx",
      "prisma",
      "ssh2"
    ]
  },
  "nx": {},
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ]
}
