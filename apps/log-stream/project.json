{
  "name": "log-stream",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/log-stream/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/log-stream",
        "main": "apps/log-stream/src/main.ts",
        "tsConfig": "apps/log-stream/tsconfig.app.json",
        "assets": [],
        "webpackConfig": "apps/log-stream/webpack.config.js",
        "generatePackageJson": false
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "log-stream:build",
        "runBuildTargetDependencies": false,
        "inspect": true
      },
      "configurations": {
        "development": {
          "buildTarget": "log-stream:build:development"
        },
        "production": {
          "buildTarget": "log-stream:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/log-stream/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
