{
  "name": "user-control-panel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/user-control-panel/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project user-control-panel --web",
  "targets": {
    "build": {
      "dependsOn": ["configs:build", "^build"]
    },
    "serve": {
      "dependsOn": ["configs:build"]
    },
    "preview": {
      "dependsOn": ["configs:build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "apps/user-control-panel"
      }
    }
  }
}
