{
  "name": "Kline Size Telegram Notification",
  "description": "Runs every 15 minutes. Fetches 1 spot kline from Binance, checks candle body size (abs(close-open)) and sends Telegram notification if above threshold. Also sends Telegram notification if Binance API returns an error.\n\nPrereqs: configure Telegram settings in auto-trader settings with codes 'main_bot' and 'error_bot'.",
  "type": "interval",
  "arguments": {
    "interval": 900000,
    "do": {
      "type": "sequence",
      "arguments": {
        "do": [
          {
            "type": "binance_spot_get_klines",
            "arguments": {
              "symbol": "BTCUSDT",
              "interval": "15m",
              "limit": 1,
              "resultKey": "klines"
            }
          },
          {
            "type": "add_to_heap",
            "arguments": {
              "items": [
                {
                  "key": "kline.open",
                  "value": "__sequenceContext__.klines.0.open"
                },
                {
                  "key": "kline.close",
                  "value": "__sequenceContext__.klines.0.close"
                }
              ]
            }
          },
          {
            "type": "if_then",
            "arguments": {
              "if": {
                "type": "resolve",
                "arguments": {
                  "expression": {
                    "__var": "__sequenceContext__.klines.error.message"
                  }
                }
              },
              "then": {
                "type": "telegram_send_message",
                "arguments": {
                  "botId": "error_bot",
                  "message": "Binance kline error: ${__sequenceContext__.klines.error.message}"
                }
              }
            }
          },
          {
            "type": "if_then",
            "arguments": {
              "if": {
                "type": "resolve",
                "arguments": {
                  "expression": {
                    "__gt": [
                      {
                        "__absolute": [
                          {
                            "__minus": [
                              {
                                "__var": "__heap__.kline.close"
                              },
                              {
                                "__var": "__heap__.kline.open"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "__const": 50
                      }
                    ]
                  }
                }
              },
              "then": {
                "type": "sequence",
                "arguments": {
                  "do": [
                    {
                      "type": "resolve",
                      "arguments": {
                        "expression": {
                          "__absolute": [
                            {
                              "__minus": [
                                { "__var": "__heap__.kline.close" },
                                { "__var": "__heap__.kline.open" }
                              ]
                            }
                          ]
                        },
                        "saveTo": "absDiff"
                      }
                    },
                    {
                      "type": "add_to_heap",
                      "arguments": {
                        "items": [
                          {
                            "key": "kline.absDiff",
                            "value": "__sequenceContext__.absDiff"
                          }
                        ]
                      }
                    },
                    {
                      "type": "telegram_send_message",
                      "arguments": {
                        "botId": "main_bot",
                        "message": "BTCUSDT 15m candle body is large. open=${__heap__.kline.open}, close=${__heap__.kline.close}, absDiff=${__heap__.kline.absDiff}"
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
