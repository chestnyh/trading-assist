{
  "name": "auto-trader",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auto-trader/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": "dist/apps/auto-trader",
        "main": "apps/auto-trader/src/main.ts",
        "tsConfig": "apps/auto-trader/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/auto-trader/src/assets",
            "output": "assets"
          }
        ]
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "apps/auto-trader"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "auto-trader:build",
        "runBuildTargetDependencies": false,
        "inspect": true
      },
      "configurations": {
        "development": {
          "buildTarget": "auto-trader:build:development"
        },
        "production": {
          "buildTarget": "auto-trader:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/auto-trader/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
