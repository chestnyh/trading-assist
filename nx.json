{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": [
        "apps/binance-api-imitation-e2e/**/*",
        "apps/binance-api-info-collector-e2e/**/*",
        "apps/api-e2e/**/*",
        "apps/auto-trader-e2e/**/*"
      ]
    }
  ],
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    }
  },
  "nxCloudAccessToken": "ODJmYTJjYzgtODVjNC00YjFmLWE5ZDItMjVlNTg3Mzc2MjE0fHJlYWQtd3JpdGU="
}
