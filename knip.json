{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [".*"],
      "entry": [
        "tools/devops/**/*.ts",
        "tools/development/**/*.ts",
        "jest.config.ts",
        "apps/*-e2e/**/*.ts"
      ],
      "jest": { "config": [] }
    },
    "libs/models": {
      "entry": [
          "src/migrations/*.ts",
          "seeds/**/*.ts",
          "prisma/**/*"
          ]
    },
    "apps/user-control-panel": {
      "webpack": { "config": [] },
      "entry": ["webpack.config.ts","src/main.tsx","src/app/index.tsx"]
    },
    "libs/api-client": {
      "entry": [
        "src/**/*.ts",
        "scripts/*.ts"
      ]
    },
    "libs/api-validator": {
      "entry": [
        "nest.js"
      ]
    }
  }
}