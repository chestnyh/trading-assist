{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@trading-assist/api-client": ["libs/api-client/src/index.ts"],
      "@trading-assist/api-validator": ["libs/api-validator/src/index.ts"],
      "@trading-assist/api-validator/nest": ["libs/api-validator/src/nest.ts"],
      "@trading-assist/configs": ["libs/configs/src/index.ts"],
      "@trading-assist/crypto-utils": ["libs/crypto-utils/src/index.ts"],
      "@trading-assist/logger": ["libs/logger/src/index.ts"],
      "@trading-assist/models": ["libs/models/src/index.ts"],
      "@trading-assist/object-navigator": ["libs/object-navigator/src/index.ts"],
      "@trading-assist/service-comm": ["libs/service-comm/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
