{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@trading-bot/api-client": ["libs/api-client/src/index.ts"],
      "@trading-bot/api-validator": ["libs/api-validator/src/index.ts"],
      "@trading-bot/api-validator/nest": ["libs/api-validator/src/nest.ts"],
      "@trading-bot/configs": ["libs/configs/src/index.ts"],
      "@trading-bot/crypto-utils": ["libs/crypto-utils/src/index.ts"],
      "@trading-bot/models": ["libs/models/src/index.ts"],
      "@trading-bot/object-navigator": ["libs/object-navigator/src/index.ts"],
      "@trading-bot/service-comm": ["libs/service-comm/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
