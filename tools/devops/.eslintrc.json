{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*","**/scripts/**/*.ts"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {"no-console": "off"}
