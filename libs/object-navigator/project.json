{
  "name": "object-navigator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/object-navigator/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "libs/object-navigator"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": "libs/object-navigator/dist",
        "main": "libs/object-navigator/src/index.ts",
        "rootDir": "libs/object-navigator/src",
        "tsConfig": "libs/object-navigator/tsconfig.lib.json",
        "assets": ["libs/object-navigator/*.md"]
      }
    }
  }
}
