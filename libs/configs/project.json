{
  "name": "configs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/configs/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "libs/configs"
      }
    },
    "compile": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": "libs/configs/dist",
        "main": "libs/configs/src/index.ts",
        "tsConfig": "libs/configs/tsconfig.lib.json",
        "assets": []
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/configs/dist"],
      "options": {
        "commands": [
          "nx run configs:compile",
          "node patch-dist-package-json.js"
        ],
        "parallel": false,
        "cwd": "libs/configs"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
