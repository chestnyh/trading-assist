{
  "name": "api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-client/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "buildLibsFromSource": false,
        "outputPath": "dist/libs/api-client",
        "main": "libs/api-client/src/index.ts",
        "tsConfig": "libs/api-client/tsconfig.lib.json",
        "assets": ["libs/api-client/*.md"]
      }
    },
    "generate-openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --transpile-only -r tsconfig-paths/register --project libs/api-client/tsconfig.lib.json libs/api-client/scripts/generate-openapi.ts",
        "cwd": "."
      }
    },
    "generate-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": "orval --config libs/api-client/orval.config.ts",
        "cwd": "."
      }
    }
  }
}
