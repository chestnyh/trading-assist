    },
    "/api/v1/auth/verify-password-reset": {
      "post": {
        "operationId": "AuthController_verifyPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyPasswordResetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification code verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyPasswordResetResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification code (with remaining attempts count)"
          },
          "401": {
            "description": "Invalid or expired token"
          },
          "429": {
            "description": "Maximum attempts exceeded - token invalidated"
          }
        },
        "summary": "Verify password reset code",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword",
