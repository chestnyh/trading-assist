              }
            }
          },
          "400": {
            "description": "Invalid password or token not verified"
          },
          "401": {
            "description": "Invalid or expired token"
          }
        },
        "summary": "Reset password with verified token",
        "tags": [
          "auth"
        ]
      }
    },
