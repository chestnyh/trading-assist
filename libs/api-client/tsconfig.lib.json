{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "paths": {
      "@trading-assist/api-validator": ["libs/api-validator/dist/src/index"],
      "@trading-assist/api-validator/*": ["libs/api-validator/dist/src/*"]
    },
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
