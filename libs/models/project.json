{
  "name": "models",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/models/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "libs/models"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "dependsOn": [
        "migrations:generate"
      ],
      "options": {
        "outputPath": "dist/libs/models",
        "main": "libs/models/src/index.ts",
        "tsConfig": "libs/models/tsconfig.lib.json",
        "assets": []
      }
    },
    "copy-generated": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/libs/models/src/generated/prisma && cp -r libs/models/src/generated/prisma/* dist/libs/models/src/generated/prisma/ 2>/dev/null || true"
      }
    },
    "migrations:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project libs/models/tsconfig.lib.json libs/models/src/migrations/run.ts",
        "cwd": "."
      }
    },
    "migrations:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project libs/models/tsconfig.lib.json libs/models/src/migrations/dev.ts",
        "cwd": "."
      }
    },
    "migrations:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project libs/models/tsconfig.lib.json libs/models/src/migrations/seed.ts libs/models/seeds/initial.ts",
        "cwd": "."
      }
    },
    "migrations:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project libs/models/tsconfig.lib.json libs/models/src/migrations/reset.ts",
        "cwd": "."
      }
    },
    "migrations:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project libs/models/tsconfig.lib.json libs/models/src/migrations/generate.ts",
        "cwd": "."
      }
    }
  }
}