generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum TradingExperienceLevel {
  Beginner
  Intermediate
  Advanced
}

enum PrimaryTradingStrategy {
  Scalping
  DayTrading
  SwingTrading
  PositionTrading
  Automated
}

enum RiskTolerance {
  Conservative
  Moderate
  Aggressive
}

enum TradingPlatform {
  Binance
  Bybit
  Kraken
  Other
}

model User {
  id    Int     @default(autoincrement()) @id
  nickname String @unique
  email String  @unique
  password String 
  firstName String
  lastName String
  isEmailVerified Boolean @default(false)
  emailVerificationToken String
  emailVerificationCode String
  passwordResetToken String?
  passwordResetCode String?
  passwordResetTokenExpiresAt DateTime?
  tradingExperienceLevel TradingExperienceLevel?
  primaryTradingStrategy PrimaryTradingStrategy?
  riskTolerance RiskTolerance?
  preferredTradingPlatforms TradingPlatform[] @default([])
  rules UserRules[]
  telegramSettings UserTelegramSettings[]
}

model UserRules {
  id    Int     @default(autoincrement()) @id
  name  String
  description String
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
  ruleBody  Json @default("{}")
}

model UserTelegramSettings {
  id    Int     @default(autoincrement()) @id
  name String
  description String
  apiToken String
  userId Int
  user User @relation(fields: [userId], references: [id])
}