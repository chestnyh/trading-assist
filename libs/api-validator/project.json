{
  "name": "api-validator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/api-validator",
  "sourceRoot": "libs/api-validator/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "libs/api-validator"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api-validator",
        "main": "libs/api-validator/src/index.ts",
        "tsConfig": "libs/api-validator/tsconfig.lib.json",
        "assets": ["libs/api-validator/*.md"]
      }
    }
  }
}
