##################### NODE ENVIRONMENT #####################
NODE_ENV=development

############### USER DATABASE CONFIGURATION ################
DB_USER=local_user
DB_PASSWORD=local_user_password
DB_NAME=local_trading_bot_db
DB_HOST=localhost
DB_PORT=5432

############### AUTO TRADER CONFIGURATION ##################
######------------------------------------------------######

############## USER CONTROL PANEL CONFIGURATION ############
UCP_PORT=4200

#################### API CONFIGURATION #####################
API_PORT=3001
MAX_PASSWORD_RESET_ATTEMPTS=5

################# DOCKER CONFIGURATION #####################
DOCKER_DB_VOLUME=./docker/volumes/local_db
DOCKER_DB_CONTAINER_NAME=postgres-dev-db
################# JWT CONFIGURATION #####################
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
